{
  "name": "paipai-charge-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "preview": "npm run build && npm run start",
    "test": "vitest run",
    "smoke:bot": "node tests/smoke-bot.mjs",
    "smoke:hell": "node tests/smoke-hell.mjs",
    "smoke:cheat": "node tests/smoke-cheat.mjs",
    "smoke:combo": "node tests/smoke-combo.mjs",
    "smoke:rps": "node tests/smoke-rps.mjs",
    "smoke:training": "node tests/smoke-training.mjs",
    "self-play": "tsx scripts/self-play.ts",
    "training:generate": "tsx scripts/generate-self-play.ts",
    "training:download": "tsx scripts/download-render-training.ts",
    "training:convert": "tsx scripts/convert-replays.ts",
    "training:train": "tsx scripts/train-policy.ts",
    "training:evaluate": "tsx scripts/evaluate-trained.ts",
    "export:training": "tsx scripts/export-training.ts",
    "check": "tsc -b && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "express": "latest",
    "lucide-react": "latest",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "latest",
    "socket.io-client": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
